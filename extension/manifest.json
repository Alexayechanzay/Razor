{
  "manifest_version": 3,
  "name": "Razor",
  "version": "0.5.0",
  "description": "Keeps YouTube on the topic you meant to study.",
  "permissions": ["storage", "alarms", "tabs", "notifications"],
  "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Razor"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
      "js": ["evaluate.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
